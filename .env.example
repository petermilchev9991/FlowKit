# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public URL of the app. Used for auth callbacks, checkout redirects and webhook URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development: leave as is. `npm run dev` starts an embedded Postgres on port 54322.
# Production: any Postgres connection string (Neon, Supabase, RDS, ...).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Optional social sign-in. Each provider turns on when both values are set.
# GitHub callback URL:  <app url>/api/auth/callback/github
# Google callback URL:  <app url>/api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Billing (Lemon Squeezy) - optional until you are ready to charge
# ---------------------------------------------------------------------------
# Settings -> API in the Lemon Squeezy dashboard
LEMONSQUEEZY_API_KEY=
# Settings -> Stores (the number in the store's ID column)
LEMONSQUEEZY_STORE_ID=
# Settings -> Webhooks: the signing secret you chose when creating the webhook
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant IDs of your subscription product, one per paid plan (see src/config/plans.ts)
LEMONSQUEEZY_PRO_VARIANT_ID=
LEMONSQUEEZY_BUSINESS_VARIANT_ID=

# ---------------------------------------------------------------------------
# AI prompt block - any OpenAI-compatible API (OpenAI, OpenRouter, Groq, Ollama, ...)
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Execution engine
# ---------------------------------------------------------------------------
# HTTP blocks refuse private and local addresses (localhost, 10.x, 192.168.x, cloud
# metadata) so users can't reach your internal network. Set to true only for local testing.
ALLOW_PRIVATE_HTTP=false

# ---------------------------------------------------------------------------
# Schedules
# ---------------------------------------------------------------------------
# Protects /api/cron/tick, which starts scheduled workflows. Needed on Vercel or
# with an external cron service; on your own server a built-in timer handles it.
CRON_SECRET=
# Set to "external" to turn the built-in timer off (it is always off on Vercel).
SCHEDULER=

# ---------------------------------------------------------------------------
# Send email block (Resend, resend.com)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
# An address on a domain you verified in Resend, e.g. "FlowKit <hello@yourdomain.com>"
EMAIL_FROM=
